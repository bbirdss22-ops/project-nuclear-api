# ============================================================
# Development environment (cloud dev) — Render dev service
# คัดลอกเป็น .env.development หรือตั้งค่าใน Render dashboard
# ============================================================

# Database (Neon dev branch — สร้างจาก Neon console)
DATABASE_URL="postgresql://user:password@dev-db.neon.tech/newclear-dev?sslmode=require"

# JWT
JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN="7d"

# Line Messaging API (test channel)
LINE_CHANNEL_SECRET="dev-line-channel-secret"
LINE_ACCESS_TOKEN="dev-line-access-token"

# Server
PORT=3000

# Supabase Storage (bank book uploads) — dev bucket
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend URL (dev cloud)
FRONTEND_URL="https://dev-project-nuclear-web.vercel.app"

# LINE activity image (dev)
ACTIVITY_IMAGE_URL="https://via.placeholder.com/600x400?text=Dev+Activity"
ACTIVITY_IMAGE_PREVIEW_URL=
