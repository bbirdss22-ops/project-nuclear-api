# ============================================================
# Production environment — Render production service
# คัดลอกเป็น .env.production หรือตั้งค่าใน Render dashboard
# ⚠️ ห้าม commit ค่าจริง
# ============================================================

# Database (Neon production)
DATABASE_URL="postgresql://user:password@prod-db.neon.tech/newclear-prod?sslmode=require"

# JWT
JWT_SECRET="prod-secret-change-me"
JWT_EXPIRES_IN="7d"

# Line Messaging API (production channel)
LINE_CHANNEL_SECRET="prod-line-channel-secret"
LINE_ACCESS_TOKEN="prod-line-access-token"

# Server
PORT=3000

# Supabase Storage — production bucket
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend URL (production)
FRONTEND_URL="https://project-nuclear-web.vercel.app"

# LINE activity image (production)
ACTIVITY_IMAGE_URL="https://real-image-url.com/activity.jpg"
ACTIVITY_IMAGE_PREVIEW_URL=
