# Database
DATABASE_URL="postgresql://user:password@host:port/db?sslmode=require"

# JWT
JWT_SECRET="your-random-secret-here"
JWT_EXPIRES_IN="7d"

# Line Messaging API
LINE_CHANNEL_SECRET="your-line-channel-secret"
LINE_ACCESS_TOKEN="your-line-access-token"

# Server
PORT=3000

# Supabase Storage (bank book uploads)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend (LINKS)
FRONTEND_URL=

# LINE activity image (T145) — public HTTPS URL, e.g. Supabase Storage public bucket:
# https://<project>.supabase.co/storage/v1/object/public/activity/<file>.jpg
# If set: sent as image message right before the welcome text. If empty: skipped (text only).
ACTIVITY_IMAGE_URL=
# Optional smaller preview image (LINE requires preview <= 240x240). Falls back to ACTIVITY_IMAGE_URL.
ACTIVITY_IMAGE_PREVIEW_URL=
