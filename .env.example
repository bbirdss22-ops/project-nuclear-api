# Database
DATABASE_URL="postgresql://user:password@host:port/db?sslmode=require"

# JWT
JWT_SECRET="your-random-secret-here"
JWT_EXPIRES_IN="7d"

# Line Messaging API — แยก dev/prod (2 channel)
# Code อ่านตาม NODE_ENV: development→LINE_CHANNEL_SECRET_DEV/LINE_ACCESS_TOKEN_DEV
#                      production →LINE_CHANNEL_SECRET_PROD/LINE_ACCESS_TOKEN_PROD
# Fallback ไป base (LINE_CHANNEL_SECRET / LINE_ACCESS_TOKEN) ถ้าไม่มี suffix
LINE_CHANNEL_SECRET_DEV="your-dev-channel-secret"
LINE_ACCESS_TOKEN_DEV="your-dev-access-token"
LINE_CHANNEL_SECRET_PROD="your-prod-channel-secret"
LINE_ACCESS_TOKEN_PROD="your-prod-access-token"

# Server
PORT=3000

# Supabase Storage (bank book uploads)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend (LINKS)
FRONTEND_URL=

# LINE activity image (T145) — public HTTPS URL, e.g. Supabase Storage public bucket:
# https://<project>.supabase.co/storage/v1/object/public/activity/<file>.jpg
# If set: sent as image message right before the welcome text. If empty: skipped (text only).
ACTIVITY_IMAGE_URL=
# Optional smaller preview image (LINE requires preview <= 240x240). Falls back to ACTIVITY_IMAGE_URL.
ACTIVITY_IMAGE_PREVIEW_URL=
